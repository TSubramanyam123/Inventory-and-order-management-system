# Generate real secrets and random demo passwords with python scripts/setup_env.py.
JWT_SECRET=replace-with-at-least-32-random-characters
SERVICE_SECRET=replace-with-a-different-32-character-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=
DATA_DIR=./data
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800
RESERVATION_SECONDS=900
RETURN_WINDOW_DAYS=30
TAX_RATE=0.18
SHIPPING_CHARGE=5000
FREE_SHIPPING_MINIMUM=200000
SERVICE_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=240
EVENT_MAX_ATTEMPTS=5
RABBITMQ_URL=amqp://inventory:inventory_local_dev@127.0.0.1/
REDIS_URL=redis://127.0.0.1:6379/0
REQUIRE_INFRA=false
WORKERS_ENABLED=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
